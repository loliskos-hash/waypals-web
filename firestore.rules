rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Private Einträge: nur der Besitzer
    match /data/users/{uid}/{doc=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Kreis-Profile: nur selbst und Freunde (angenommene Anfrage in eine der beiden Richtungen)
    match /pals/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid
        || isFriend(uid + '_' + request.auth.uid) || isFriend(request.auth.uid + '_' + uid));
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    // Wer mich blockiert hat, darf mir nichts schicken
    function blockedBy(owner) {
      return exists(/databases/$(database)/documents/blocks/$(owner))
        && request.auth.uid in get(/databases/$(database)/documents/blocks/$(owner)).data.get('b', {});
    }
    // Block- und Stummliste: nur der Besitzer
    match /blocks/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    function isFriend(id) {
      return exists(/databases/$(database)/documents/friendRequests/$(id))
        && get(/databases/$(database)/documents/friendRequests/$(id)).data.status == 'accepted';
    }
    // Freundschaftsanfragen: ID = absender_empfänger; sehen nur die beiden Beteiligten
    match /friendRequests/{id} {
      allow get: if request.auth != null && (resource == null
        || resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow list: if request.auth != null
        && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to != request.auth.uid
        && id == request.auth.uid + '_' + request.resource.data.to
        && request.resource.data.status == 'pending'
        && !blockedBy(request.resource.data.to);
      allow update: if request.auth != null
        && resource.data.to == request.auth.uid
        && request.resource.data.from == resource.data.from
        && request.resource.data.to == resource.data.to
        && request.resource.data.status in ['accepted', 'declined'];
      allow delete: if request.auth != null
        && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
    }
    // Meldungen: nur anlegen (als man selbst); lesen nur die Betreiberin in der Firebase Console
    match /reports/{id} {
      allow create: if request.auth != null
        && request.resource.data.by == request.auth.uid
        && request.resource.data.keys().hasOnly(['by','uid','kind','ref','name','reason','text','at'])
        && request.resource.data.text is string && request.resource.data.text.size() <= 1000;
      allow read, update, delete: if false;
    }
    // Benutzernamen: nur exakter Abruf (kein Durchstöbern); anlegen, ändern, löschen nur für sich selbst
    match /usernames/{name} {
      allow get: if request.auth != null;
      allow list: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null
        && name.matches('^[a-z0-9_.]{3,20}$')
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid','name','av','level','title','at']);
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid','name','av','level','title','at']);
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }
    // Challenges: anlegen nur als Absender; ändern/löschen nur Absender oder Empfänger
    match /quests/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.from == request.auth.uid
        && !blockedBy(request.resource.data.to);
      allow update, delete: if request.auth != null
        && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
    }
    // Wander-Taube: anlegen nur als Absender; weitergeben nur wer die Taube gerade hat; löschen nur Absender
    match /flocks/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.from == request.auth.uid
        && !blockedBy(request.resource.data.holder);
      allow update: if request.auth != null && resource.data.holder == request.auth.uid
        && request.resource.data.from == resource.data.from
        && (request.resource.data.holder == resource.data.holder || !blockedBy(request.resource.data.holder));
      allow delete: if request.auth != null && resource.data.from == request.auth.uid;
    }
  }
}
